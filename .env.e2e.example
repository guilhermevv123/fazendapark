# Banco e servidor da bateria E2E (Playwright) — copie pra .env.e2e.
# Isolados do painel real (3100, diamond_tickets) e da suíte vitest (3101, diamond_tickets_test).
# O nome do banco TEM que terminar em _e2e: scripts/e2e-banco.mjs e dev-e2e.mjs recusam outro.
DATABASE_URL=postgresql://SEU_USUARIO@localhost:5432/diamond_tickets_e2e
BASE_TESTE=http://localhost:3120
PUBLIC_BASE_URL=http://localhost:3120
PAGAMENTO_SIMULADO=1
# opcional: painel dos agentes (Sofia/n8n) — ver server/utils/agentes.ts
# AGENTES_API_URL=https://SEU_N8N/webhook/fazenda-park-painel-agentes
# AGENTES_API_TOKEN=
