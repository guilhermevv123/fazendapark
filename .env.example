# Diamond Tickets — variáveis de ambiente
#
# Copie para .env (máquina) ou cadastre no ambiente do deploy (EasyPanel).
# O que falta em produção GRITA no boot ([config] no log) e em /api/saude:
# nenhuma falta de configuração falha em silêncio. Os valores abaixo são
# exemplos — nunca comite um .env com valor de verdade.

# ------------------------------------------------------------------ banco
DATABASE_URL=postgresql://usuario:senha@localhost:5432/diamond_tickets
# conexões do pool (padrão 10)
PG_POOL_MAX=

# ------------------------------------------------------------ servidor
NODE_ENV=production
# segredo da sessão do painel (32+ caracteres). Também assina o QR no formato
# ANTIGO (DT1) enquanto TICKET_KEYS não estiver configurada — trocar este valor
# com ingressos DT1 vendidos invalida todos eles.
NUXT_SESSION_SECRET=
# a URL pública do site, sem barra no fim. Em produção, sem ela (ou com
# localhost) o e-mail do ingresso sai SEM o link do pedido.
PUBLIC_BASE_URL=https://ingressos.seudominio.com.br
# atrás do proxy do EasyPanel (Traefik): 1. Atrás do Cloudflare: cloudflare.
# Sem isto todo mundo chega com o IP do proxy e o freio por IP (login, loja)
# fica DESLIGADO — o boot e /api/saude avisam quando detectam o proxy.
CONFIAR_PROXY=1
# diagnóstico completo de /api/saude em produção (cabeçalho x-monitor-token);
# 32+ caracteres. Sem ele a rota responde só ok/503.
MONITOR_TOKEN=

# -------------------------------------------------------- pagamento (Asaas)
# A CHAVE do Asaas é por organização, no painel (Configurações). Aqui fica só o
# token do webhook — o mesmo cadastrado no painel de webhooks do Asaas. Em
# produção, sem ele o webhook recusa todo aviso de pagamento e a vitrine NÃO
# vende (o PIX cairia e o ingresso não sairia).
ASAAS_WEBHOOK_TOKEN=
# não lido pelo código: o ambiente do Asaas é o da chave de cada organização
ASAAS_ENV=
# gateway de mentira pra rodar o fluxo na máquina; nunca liga em produção
PAGAMENTO_SIMULADO=
# minutos em análise de risco antes de perguntar ao Asaas (padrão 120)
EM_ANALISE_PERGUNTAR_APOS_MIN=

# ------------------------------------------------------------- ingresso (QR)
# Chave própria de assinatura do QR, formato DT2: "kid:base64" (32+ bytes),
# várias separadas por vírgula — a PRIMEIRA assina, todas conferem (rotação).
# Gerar: node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: só configure depois que a validação OFFLINE da portaria ler DT2;
# até lá o QR segue DT1 (assinado com NUXT_SESSION_SECRET).
TICKET_KEYS=
# chave que confere os QR DT1 já vendidos, se um dia NUXT_SESSION_SECRET for
# trocado (padrão: o próprio NUXT_SESSION_SECRET)
TICKET_KEY_LEGADO_DT1=

# ---------------------------------------------------------------- e-mail
# smtp://usuario:senha@servidor:587 ou smtps://…:465. Em produção, sem ele o
# e-mail do ingresso NÃO sai (a fila registra a falha) — a não ser que
# EMAIL_TRANSPORTE=simulado declare o ensaio.
SMTP_URL=
EMAIL_REMETENTE=Conquista Park <ingressos@seudominio.com.br>
# simulado | smtp (padrão: smtp quando há SMTP_URL)
EMAIL_TRANSPORTE=
SMTP_EHLO=
SMTP_TIMEOUT_MS=
# 1 aceita certificado do servidor SMTP sem conferir (só pra servidor interno)
SMTP_TLS_FROUXO=
# onde o modo simulado grava o .eml
EMAIL_PASTA_SIMULADO=

# ----------------------------------------------------- freio da loja (B03/B04)
# "limite/segundos" por IP; "0" desliga o balde. Padrões seguros de produção:
FREIO_CHECKOUT=20/600
FREIO_CHECKOUT_INGRESSOS=60/1200
FREIO_CUPOM=30/600
FREIO_CUPOM_ERRADO=10/900
FREIO_PEDIDO_404=20/600

# ------------------------------------------------------------ filas de fundo
# off desliga a fila NESTE processo (com mais de uma instância, deixe uma ligada)
DT_ENVIO_WORKER=
DT_ESTORNO_WORKER=
DT_WEBHOOK_WORKER=
ENVIO_INTERVALO_MS=
DT_ESTORNO_INTERVALO_MS=
DT_WEBHOOK_INTERVALO_MS=
DT_WEBHOOK_CARENCIA_MIN=

# ------------------------------------------------------- fuso e armazenamento
TZ=America/Bahia
TZ_EVENTO=
FUSO_BANCO=
# Cloudflare R2 (banner/miniatura de evento)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ------------------------------------------------ painel dos agentes (Sofia/n8n)
AGENTES_API_URL=
AGENTES_API_TOKEN=
